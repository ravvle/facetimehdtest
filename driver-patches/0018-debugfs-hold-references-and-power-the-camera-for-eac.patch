From 37ecd0822964766294d10aee45c8c3d8005e7d14 Mon Sep 17 00:00:00 2001
From: facetimehd downstream <facetimehd-downstream@localhost>
Date: Thu, 8 Oct 2026 12:00:00 +1000
Subject: [PATCH 18/21] debugfs: hold references, and power the camera for each
 access

Create the debugfs tree once per device under a shared root, take a
reference on the device for each open file, and take a runtime-PM
reference around every access that talks to the firmware. Bound and
validate the debug command input, and refuse access during removal.
---
 fthd_debugfs.c | 337 +++++++++++++++++++++++++++++++++++++------------
 1 file changed, 257 insertions(+), 80 deletions(-)

diff --git a/fthd_debugfs.c b/fthd_debugfs.c
index 50ab5a7..5855242 100644
--- a/fthd_debugfs.c
+++ b/fthd_debugfs.c
@@ -10,74 +10,121 @@
 #include <linux/kernel.h>
 #include <linux/spinlock.h>
 #include <linux/debugfs.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
 #include "fthd_drv.h"
 #include "fthd_debugfs.h"
 #include "fthd_isp.h"
 #include "fthd_ringbuf.h"
 #include "fthd_hw.h"
 
+static DEFINE_MUTEX(fthd_debugfs_lock);
+static struct dentry *fthd_debugfs_root;
+static unsigned int fthd_debugfs_users;
+
+static int fthd_debugfs_open(struct inode *inode, struct file *file)
+{
+	struct fthd_private *dev_priv = inode->i_private;
+
+	if (!fthd_get(dev_priv))
+		return -ENODEV;
+	if (READ_ONCE(dev_priv->removing)) {
+		fthd_put(dev_priv);
+		return -ENODEV;
+	}
+
+	file->private_data = dev_priv;
+	return 0;
+}
+
+static int fthd_debugfs_release(struct inode *inode, struct file *file)
+{
+	fthd_put(file->private_data);
+	return 0;
+}
