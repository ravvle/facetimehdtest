+/* The corresponding GET writes the same bias/tag pair after the channel. */
+struct isp_cmd_channel_ae_bias_get {
+	u32 channel;
+	u16 bias;
+	u16 reserved;
+	u32 tag;
+};
+
+/* Scalar AE and AWB commands carry one firmware-native word after channel. */
