 fthd_isp.c  | 45 ++++++++++++++++++++++++++++++---------------
 fthd_isp.h  | 11 ++++++++++-
 fthd_v4l2.c | 49 +++++++++++++++++++++++++++++++------------------
 4 files changed, 71 insertions(+), 35 deletions(-)

