From 6d24edf416cb8bb407dde884b9f798785b9a12c1 Mon Sep 17 00:00:00 2001
From: facetimehd downstream <facetimehd-downstream@localhost>
Date: Thu, 8 Oct 2026 12:00:00 +1000
Subject: [PATCH 04/21] hw: propagate PLL and DDR bring-up failures

Rewrite the S2 PLL lock wait as a bounded loop that checks the lock bit
before sleeping, and return errors from the DDR preinit and mode-register
rewrite steps instead of continuing on a controller that did not come up.
---
 fthd_hw.c | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/fthd_hw.c b/fthd_hw.c
index 0f0ed8b..b0cbc9f 100644
--- a/fthd_hw.c
+++ b/fthd_hw.c
@@ -132,13 +132,14 @@ static int fthd_hw_s2_pll_init(struct fthd_private *dev_priv, u32 ddr_speed)
 	dev_dbg(&dev_priv->pdev->dev, "Waiting for S2 PLL to lock at %d MHz\n",
 		ddr_speed);
 
-	do {
+	for (retries = 0; retries < 10000; retries++) {
 		reg = FTHD_S2_REG_READ(S2_PLL_CMU_STATUS);
+		if (reg & S2_PLL_CMU_STATUS_LOCKED)
+			break;
 		udelay(10);
-		retries++;
-	} while (!(reg & S2_PLL_CMU_STATUS_LOCKED) && retries <= 10000);
+	}
 
-	if (retries > 10000) {
+	if (retries >= 10000) {
 		dev_err(&dev_priv->pdev->dev, "Failed to lock S2 PLL: 0x%x\n",
 			reg);
 		return -EINVAL;
@@ -600,7 +601,9 @@ static int fthd_hw_s2_init_ddr_controller_soc(struct fthd_private *dev_priv)
 	FTHD_S2_REG_WRITE(val, S2_3208);
 	FTHD_S2_REG_WRITE(0x1040, S2_3200);
 
-	fthd_hw_ddr_rewrite_mode_regs(dev_priv);
+	ret = fthd_hw_ddr_rewrite_mode_regs(dev_priv);
+	if (ret)
+		return ret;
 
 	FTHD_S2_REG_WRITE(0x20000, S2_DDR_2014);
 	FTHD_S2_REG_WRITE(1, S2_DDR_2008);
@@ -656,7 +659,10 @@ int fthd_hw_init(struct fthd_private *dev_priv)
 	if (ret)
 		goto out;
 
-	fthd_hw_s2_preinit_ddr_controller_soc(dev_priv);
+	ret = fthd_hw_s2_preinit_ddr_controller_soc(dev_priv);
+	if (ret)
+		goto out;
+
 	ret = fthd_hw_s2_init_ddr_controller_soc(dev_priv);
 	if (ret)
 		goto out;
