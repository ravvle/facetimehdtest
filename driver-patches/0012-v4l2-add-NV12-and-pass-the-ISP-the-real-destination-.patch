+					   int stride, int pixelformat)
 {
 	struct isp_cmd_channel_output_config cmd;
 	int len;
 
-	pr_debug("output config: [%d, %d]\n", x, y);
+	pr_debug("output config: [%d, %d] stride %d\n", x, y, stride);
 
