From e1f560bf1e24ebbd6309fde8e2c4848b1d555484 Mon Sep 17 00:00:00 2001
From: facetimehd downstream <facetimehd-downstream@localhost>
Date: Thu, 8 Oct 2026 12:00:00 +1000
Subject: [PATCH 08/21] isp: validate what the firmware hands back

Treat the firmware as an untrusted producer:

- validate the channel description table (count, type, source, ring
  bounds) before using it, and NUL-terminate channel names;
- track ISP memory objects on a list and free shared memory by offset
  instead of reading a kernel pointer back from ISP memory, and stop
  writing kernel pointers into it;
- bound the IRQ work loop and each ring drain, and turn the BUG_ON()
  on a bad channel source into a WARN_ON_ONCE();
- check the sensor count and resolutions the firmware reports;
- replace the BUG_ON() on a duplicate set-file load with a warning, and
  handle a failed set-file allocation.
---
 fthd_drv.c |  48 +++++++++++-----
 fthd_drv.h |   4 +-
 fthd_isp.c | 159 ++++++++++++++++++++++++++++++++++++++++++++---------
 fthd_isp.h |   4 ++
 4 files changed, 175 insertions(+), 40 deletions(-)

diff --git a/fthd_drv.c b/fthd_drv.c
index a8bd2c9..a2123ef 100644
--- a/fthd_drv.c
+++ b/fthd_drv.c
@@ -87,6 +87,7 @@ static void sharedmalloc_handler(struct fthd_private *dev_priv,
 {
 	u32 request_size, response_size, address;
 	struct isp_mem_obj *obj;
+	u8 header[64] = { 0 };
 	int ret;
 
 	request_size = FTHD_S2_MEM_READ(entry + FTHD_RINGBUF_REQUEST_SIZE);
@@ -95,14 +96,19 @@ static void sharedmalloc_handler(struct fthd_private *dev_priv,
 
 	if (address) {
 		pr_debug("Firmware wants to free memory at %08x\n", address);
-		FTHD_S2_MEMCPY_FROMIO(&obj, address - 64, sizeof(obj));
-		isp_mem_destroy(obj);
+		if (address < sizeof(header) ||
+		    isp_mem_destroy_offset(dev_priv, address - sizeof(header),
+					   FTHD_MEM_SHAREDMALLOC))
+			dev_warn(&dev_priv->pdev->dev,
+				 "Firmware requested invalid shared-memory free at %#x\n",
+				 address);
 
 		ret = fthd_channel_ringbuf_send(dev_priv, chan, 0, 0, 0, NULL);
 		if (ret)
 			dev_err(&dev_priv->pdev->dev, "%s: fthd_channel_ringbuf_send: %d\n", __func__, ret);
 	} else {
-		if (!request_size)
+		if (dev_priv->s2_mem_len < sizeof(header) || !request_size ||
+		    request_size > dev_priv->s2_mem_len - sizeof(header))
 			return;
 		obj = isp_mem_create(dev_priv, FTHD_MEM_SHAREDMALLOC, request_size + 64);
 		if (!obj)
@@ -111,10 +117,16 @@ static void sharedmalloc_handler(struct fthd_private *dev_priv,
 		pr_debug("Firmware allocated %d bytes at %08lx (tag %c%c%c%c)\n", request_size, obj->offset,
 			 response_size >> 24,response_size >> 16,
 			 response_size >> 8, response_size);
-		FTHD_S2_MEMCPY_TOIO(obj->offset, &obj, sizeof(obj));
+		ret = FTHD_S2_MEMCPY_TOIO(obj->offset, header, sizeof(header));
+		if (ret) {
+			isp_mem_destroy(obj);
+			return;
+		}
 		ret = fthd_channel_ringbuf_send(dev_priv, chan, obj->offset + 64, 0, 0, NULL);
-		if (ret)
+		if (ret) {
 			dev_err(&dev_priv->pdev->dev, "%s: fthd_channel_ringbuf_send: %d\n", __func__, ret);
+			isp_mem_destroy(obj);
+		}
 
 	}
 
@@ -180,7 +192,7 @@ static void io_t2h_handler(struct fthd_private *dev_priv,
 static void fthd_handle_irq(struct fthd_private *dev_priv, struct fw_channel *chan)
 {
 	u32 entry;
-	int ret;
+	int handled, ret;
 
 	if (chan == dev_priv->channel_io) {
 		pr_debug("IO channel ready\n");
@@ -200,7 +212,12 @@ static void fthd_handle_irq(struct fthd_private *dev_priv, struct fw_channel *ch
 		return;
 	}
 
-	while((entry = fthd_channel_ringbuf_receive(dev_priv, chan)) != (u32)-1) {
+	/* A corrupt or wedged producer must not keep the global workqueue busy
+	 * forever.  There cannot be more live entries than the ring contains. */
+	for (handled = 0; handled < chan->size; handled++) {
+		entry = fthd_channel_ringbuf_receive(dev_priv, chan);
+		if (entry == (u32)-1)
+			break;
 		pr_debug("channel %s: message available, address %08x\n", chan->name, FTHD_S2_MEM_READ(entry + FTHD_RINGBUF_ADDRESS_FLAGS));
 		if (chan == dev_priv->channel_shared_malloc) {
 			sharedmalloc_handler(dev_priv, chan, entry);
@@ -215,6 +232,9 @@ static void fthd_handle_irq(struct fthd_private *dev_priv, struct fw_channel *ch
 			io_t2h_handler(dev_priv, chan, entry);
 		}
 	}
+	if (handled == chan->size)
+		dev_warn_ratelimited(&dev_priv->pdev->dev,
+				     "channel %s did not drain\n", chan->name);
 }
 
 static void fthd_irq_uninstall(struct fthd_private *dev_priv)
@@ -228,9 +248,9 @@ static void fthd_irq_work(struct work_struct *work)
 	struct fw_channel *chan;
 
 	u32 pending;
-	int i = 0;
+	int i, loops;
 
-	while(i++ < 500) {
+	for (loops = 0; loops < 500; loops++) {
 		spin_lock_irq(&dev_priv->io_lock);
 		pending = FTHD_ISP_REG_READ(ISP_IRQ_STATUS);
 		spin_unlock_irq(&dev_priv->io_lock);
@@ -244,18 +264,18 @@ static void fthd_irq_work(struct work_struct *work)
 		spin_unlock_irq(&dev_priv->io_lock);
 		pci_write_config_dword(dev_priv->pdev, 0x90, 0x200);
 
-		for(i = 0; i < dev_priv->num_channels; i++) {
+		for (i = 0; i < dev_priv->num_channels; i++) {
 			chan = dev_priv->channels[i];
 
-
-			BUG_ON(chan->source > 3);
+			if (WARN_ON_ONCE(chan->source > 3))
+				continue;
 			if (!((0x10 << chan->source) & pending))
 				continue;
 			fthd_handle_irq(dev_priv, chan);
 		}
 	}
 
-	if (i >= 500) {
+	if (loops >= 500) {
 		dev_err(&dev_priv->pdev->dev, "irq stuck, disabling\n");
 		fthd_irq_uninstall(dev_priv);
 	}
@@ -469,6 +489,8 @@ static int fthd_pci_probe(struct pci_dev *pdev,
 	mutex_init(&dev_priv->ioctl_lock);
 	atomic_set(&dev_priv->users, 0);
 	INIT_LIST_HEAD(&dev_priv->buffer_queue);
+	mutex_init(&dev_priv->mem_lock);
+	INIT_LIST_HEAD(&dev_priv->mem_objects);
 	INIT_WORK(&dev_priv->irq_work, fthd_irq_work);
 
 	dev_priv->pdev = pdev;
