@@ -690,6 +690,16 @@ struct isp_cmd_channel_ae_flicker_freq_set {
  * FIRMWARE-REVERSE-ENGINEERING.md.
  */
 
+/* Firmware reads a 16-bit value and a 32-bit tag. The encoding and tag
