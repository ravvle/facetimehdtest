From c0f4f06ac250e26a426d90a3e58aa4d064bc4875 Mon Sep 17 00:00:00 2001
From: facetimehd downstream <facetimehd-downstream@localhost>
Date: Thu, 8 Oct 2026 12:00:00 +1000
Subject: [PATCH 03/21] driver: quieten bring-up logging, report failures as
 errors

The PLL, DDR and ISP bring-up messages read like once-per-boot banners
but run on every firmware load, so make them dev_dbg and print a single
"camera ready" line at probe instead. FWMSG, the firmware's own console,
arrives per message while streaming and becomes dev_dbg too. Messages
that report a failure move the other way, from dev_info to dev_err, and
the remaining pr_err() calls become dev_err() so they name the device.
---
 fthd_drv.c  | 23 +++++++++++-----
 fthd_hw.c   | 76 ++++++++++++++++++++++++++---------------------------
 fthd_isp.c  | 46 ++++++++++++++++----------------
 fthd_v4l2.c |  6 ++---
 4 files changed, 80 insertions(+), 71 deletions(-)

diff --git a/fthd_drv.c b/fthd_drv.c
index b102919..044cc66 100644
--- a/fthd_drv.c
+++ b/fthd_drv.c
@@ -100,7 +100,7 @@ static void sharedmalloc_handler(struct fthd_private *dev_priv,
 
 		ret = fthd_channel_ringbuf_send(dev_priv, chan, 0, 0, 0, NULL);
 		if (ret)
-			pr_err("%s: fthd_channel_ringbuf_send: %d\n", __FUNCTION__, ret);
+			dev_err(&dev_priv->pdev->dev, "%s: fthd_channel_ringbuf_send: %d\n", __func__, ret);
 	} else {
 		if (!request_size)
 			return;
@@ -114,7 +114,7 @@ static void sharedmalloc_handler(struct fthd_private *dev_priv,
 		FTHD_S2_MEMCPY_TOIO(obj->offset, &obj, sizeof(obj));
 		ret = fthd_channel_ringbuf_send(dev_priv, chan, obj->offset + 64, 0, 0, NULL);
 		if (ret)
-			pr_err("%s: fthd_channel_ringbuf_send: %d\n", __FUNCTION__, ret);
+			dev_err(&dev_priv->pdev->dev, "%s: fthd_channel_ringbuf_send: %d\n", __func__, ret);
 
 	}
 
@@ -137,7 +137,11 @@ static void terminal_handler(struct fthd_private *dev_priv,
 	if (request_size > 512)
 		request_size = 512;
 	FTHD_S2_MEMCPY_FROMIO(buf, address, request_size);
-	pr_info("FWMSG: %.*s", request_size, buf);
+	/* The firmware's own console. Interesting when debugging the ISP,
+	 * noise the rest of the time - and it arrives per firmware message,
+	 * so at dev_info it is the single largest contributor to the log
+	 * volume this driver produces while streaming. */
+	dev_dbg(&dev_priv->pdev->dev, "FWMSG: %.*s", request_size, buf);
 }
 
 static void buf_t2h_handler(struct fthd_private *dev_priv,
@@ -158,7 +162,7 @@ static void buf_t2h_handler(struct fthd_private *dev_priv,
 	ret = fthd_channel_ringbuf_send(dev_priv, chan, (response_size & 0x10000000) ? address : 0,
 					0, 0x80000000, NULL);
 	if (ret)
-		pr_err("%s: fthd_channel_ringbuf_send: %d\n", __FUNCTION__, ret);
+		dev_err(&dev_priv->pdev->dev, "%s: fthd_channel_ringbuf_send: %d\n", __func__, ret);
 
 }
 
@@ -168,7 +172,7 @@ static void io_t2h_handler(struct fthd_private *dev_priv,
 {
 	int ret = fthd_channel_ringbuf_send(dev_priv, chan, 0, 0, 0, NULL);
 	if (ret)
-		pr_err("%s: fthd_channel_ringbuf_send: %d\n", __FUNCTION__, ret);
+		dev_err(&dev_priv->pdev->dev, "%s: fthd_channel_ringbuf_send: %d\n", __func__, ret);
 
 }
 
@@ -203,7 +207,7 @@ static void fthd_handle_irq(struct fthd_private *dev_priv, struct fw_channel *ch
 			terminal_handler(dev_priv, chan, entry);
 			ret = fthd_channel_ringbuf_send(dev_priv, chan, 0, 0, 0, NULL);
 			if (ret)
-				pr_err("%s: fthd_channel_ringbuf_send: %d\n", __FUNCTION__, ret);
+				dev_err(&dev_priv->pdev->dev, "%s: fthd_channel_ringbuf_send: %d\n", __func__, ret);
 		} else if (chan == dev_priv->channel_buf_t2h) {
 			buf_t2h_handler(dev_priv, chan, entry);
 		} else if (chan == dev_priv->channel_io_t2h) {
@@ -390,7 +394,7 @@ static int fthd_pci_init(struct fthd_private *dev_priv)
 	if (ret)
 		goto fail_irq;
 
-	dev_info(&pdev->dev, "Setting %ubit DMA mask\n", dev_priv->dma_mask);
+	dev_dbg(&pdev->dev, "Setting %ubit DMA mask\n", dev_priv->dma_mask);
 
 	pci_set_master(pdev);
 	pci_set_drvdata(pdev, dev_priv);
@@ -490,6 +494,11 @@ static int fthd_pci_probe(struct pci_dev *pdev,
 	ret = fthd_debugfs_init(dev_priv);
 	if (ret)
 		goto fail_v4l2;
+
+	/* One line per probe, carrying what the twenty-line bring-up banner
+	 * used to be read for; everything else on that path is dev_dbg. */
+	dev_info(&pdev->dev, "camera ready: DDR %u MHz, %u-bit DMA\n",
+		 dev_priv->ddr_speed, dev_priv->dma_mask);
 	return 0;
 fail_v4l2:
 	fthd_v4l2_unregister(dev_priv);
