@@ -344,8 +344,8 @@ static int fthd_hw_s2_init_ddr_controller_soc(struct fthd_private *dev_priv)
 		return -EIO;
 	}
 
-	dev_info(&dev_priv->pdev->dev,
-		 "DDR40 PHY PLL locked on safe settings\n");
+	dev_dbg(&dev_priv->pdev->dev,
+		"DDR40 PHY PLL locked on safe settings\n");
 
